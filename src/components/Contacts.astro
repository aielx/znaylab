---
import { site } from '../content/site';
---

<section class="section" id="contacts">
  <div class="container">
    <div class="section-head">
      <span class="kicker">Контакты</span>
      <h2>Ждём вас и ваших детей</h2>
    </div>

    <div class="contacts__grid">
      <div class="contacts__info">
        <div class="contacts__row">
          <h3>Адрес</h3>
          <p>{site.address}</p>
        </div>
        <div class="contacts__row">
          <h3>Телефон</h3>
          <p><a href={site.phoneHref} data-goal="phone">{site.phoneDisplay}</a></p>
        </div>
        <div class="contacts__row">
          <h3>Мессенджеры</h3>
          <p class="contacts__messengers">
            <a href={site.max} target="_blank" rel="noopener" data-goal="max">MAX</a>
          </p>
        </div>
        <div class="contacts__row">
          <h3>Часы работы</h3>
          <p>{site.hours}</p>
        </div>
      </div>

      <div class="contacts__map card">
        <iframe
          src={`https://yandex.ru/map-widget/v1/?z=16&ol=biz&oid=${site.yandexOrgId}`}
          title="ЗнайЛаб на карте: г. Ликино-Дулёво, ул. Ленина, 3"
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .contacts__grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: stretch;
  }
  .contacts__info { display: flex; flex-direction: column; gap: 22px; }
  .contacts__row h3 { font-size: 14px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--teal); margin-bottom: 4px; }
  .contacts__row p { font-size: 17px; font-weight: 600; }
  .contacts__row a { color: var(--text); text-decoration: none; }
  .contacts__row a:hover { color: var(--blue-dark); }
  .contacts__messengers { display: flex; gap: 18px; }
  .contacts__messengers a { color: var(--blue-dark); font-weight: 700; }
  .contacts__map { overflow: hidden; min-height: 340px; }
  .contacts__map iframe { width: 100%; height: 100%; min-height: 340px; border: 0; }
  @media (max-width: 860px) { .contacts__grid { grid-template-columns: 1fr; } }
</style>
