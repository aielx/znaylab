---
import Photo from './Photo.astro';
import { directions } from '../content/directions';
---

<section class="section" id="directions">
  <div class="container">
    <div class="section-head">
      <span class="kicker">Направления</span>
      <h2>Чему учим</h2>
      <p class="lead">Восемь направлений для детей от 2 до 17 лет. Нажмите на карточку — откроется форма записи с уже выбранным направлением.</p>
    </div>

    <div class="directions__grid">
      {directions.map((d, i) => (
        <article class:list={['directions__card', 'card', 'reveal']} style={`transition-delay: ${(i % 4) * 60}ms`}>
          <button class="directions__btn" type="button" data-open-lead data-direction={d.id}>
            {d.photo && (
              <div class="directions__media">
                <Photo
                  name={d.photo}
                  sizes="(max-width: 720px) 100vw, (max-width: 1100px) 50vw, 25vw"
                  position="center 30%"
                />
              </div>
            )}
            <div class="directions__body">
              <h3>{d.title}</h3>
              <p class="directions__meta">{d.age} · {d.formats}</p>
              <p class="directions__promise">{d.promise}</p>
              <span class="directions__link">Записаться →</span>
            </div>
          </button>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .directions__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .directions__card { overflow: hidden; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .directions__card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .directions__btn {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    text-align: left;
  }
  .directions__media { overflow: hidden; }
  .directions__media :global(.photo) { transition: transform 0.35s ease; }
  .directions__card:hover .directions__media :global(.photo) { transform: scale(1.04); }
  .directions__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    flex-grow: 1;
  }
  .directions__meta { font-size: 13.5px; font-weight: 700; color: var(--teal); text-transform: uppercase; letter-spacing: 0.04em; }
  .directions__promise { font-size: 15px; color: var(--muted); flex-grow: 1; }
  .directions__link { font-weight: 700; color: var(--blue-dark); font-size: 15px; }

  @media (max-width: 1100px) { .directions__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .directions__grid { grid-template-columns: 1fr; } }
</style>
