---
import Photo from './Photo.astro';
import { site } from '../content/site';

/*
  Варианты hero-заголовка (основной — первый, остальные для A/B или замены):
  1. «ЗнайЛаб — образовательный центр, созданный на базе “Интеллекта”»
  2. «ЗнайЛаб — 15 лет опыта “Интеллекта” в новом образовательном центре»
  3. «ЗнайЛаб: проверенные программы “Интеллекта” — в современном формате»
  4. «ЗнайЛаб — детский образовательный центр на базе “Интеллекта”»
  5. «ЗнайЛаб: лучшие наработки “Интеллекта” — для вашего ребёнка»
*/
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <span class="badge hero__badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 2l2.4 6.2H21l-5.2 4.1 1.9 6.5L12 15l-5.7 3.8 1.9-6.5L3 8.2h6.6L12 2z" fill="currentColor"/>
        </svg>
        15 лет опыта — в основе программ
      </span>
      <h1>
        ЗнайЛаб — образовательный центр, созданный на базе <span class="hero__hl">«Интеллекта»</span>
      </h1>
      <p class="lead">
        Занятия для детей от 2 до 17 лет по программам, проверенным 15 годами работы.
        Запишите ребёнка на пробное занятие — это бесплатно и ни к чему не обязывает.
      </p>
      <div class="hero__actions">
        <button class="btn btn--primary btn--lg" type="button" data-open-lead data-goal="cta_signup">
          Записаться на занятие
        </button>
        {site.paymentUrl && (
          <a class="btn btn--outline btn--lg" href={site.paymentUrl} target="_blank" rel="noopener" data-goal="cta_pay">
            Оплатить занятия
          </a>
        )}
      </div>
      <p class="hero__note">2–17 лет · групповые и индивидуальные занятия · 40 направлений</p>
    </div>

    <div class="hero__media">
      <Photo
        name="english-group-unionjack"
        ratio="4 / 3"
        ratioMobile="16 / 11"
        sizes="(max-width: 980px) 100vw, 52vw"
        loading="eager"
        fetchpriority="high"
        position="center 35%"
        class="hero__frame"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60% 80% at 85% 10%, rgb(20 184 166 / 0.12), transparent 60%),
      radial-gradient(50% 60% at 5% 90%, rgb(124 58 237 / 0.08), transparent 60%),
      var(--bg);
    padding-block: clamp(40px, 6vw, 88px);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  .hero__badge { margin-bottom: 18px; }
  .hero__hl {
    background: var(--grad-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    white-space: nowrap;
  }
  .hero .lead { max-width: 54ch; }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }
  .hero__note {
    margin-top: 20px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .hero__media {
    position: relative;
  }
  .hero__media :global(.hero__frame) {
    border-radius: 24px;
    box-shadow: var(--shadow-lg);
  }
  .hero__media::before {
    content: '';
    position: absolute;
    top: -14px;
    left: -14px;
    width: 120px;
    height: 120px;
    border-radius: 28px;
    background: var(--grad-brand);
    opacity: 0.18;
    z-index: -1;
  }
  @media (max-width: 980px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__media { order: -1; }
  }
</style>
