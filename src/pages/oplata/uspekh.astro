---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../content/site';
---

<BaseLayout
  title="Оплата прошла успешно — ЗнайЛаб"
  description="Платёж принят. Чек будет отправлен на ваш e-mail."
  path="/oplata/uspekh"
>
  <Header />
  <main id="main" class="section result">
    <div class="container result__box card">
      <div class="result__icon result__icon--ok" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 12.5l5 5L20 6.5" />
        </svg>
      </div>
      <h1>Оплата прошла успешно</h1>
      <p>
        Спасибо! Кассовый чек придёт на указанный e-mail в течение нескольких минут.
        Если возникнут вопросы — позвоните нам: <a href={site.phoneHref}>{site.phoneDisplay}</a>.
      </p>
      <p class="result__order" id="order-id" hidden></p>
      <a class="btn btn--primary btn--lg" href="/">На главную</a>
    </div>
    <script>
      // Банк/CRM могут вернуть номер платежа в query-параметрах — покажем его.
      const params = new URLSearchParams(location.search);
      const id =
        params.get('orderId') ||
        params.get('orderNumber') ||
        params.get('order') ||
        params.get('orderId1') ||
        '';
      const el = document.getElementById('order-id');
      if (id && el) {
        el.textContent = `Номер платежа: ${id}`;
        el.hidden = false;
      }
    </script>
  </main>
  <Footer />
</BaseLayout>

<style>
  .result { display: grid; place-items: center; min-height: 50vh; }
  .result__box { max-width: 560px; margin-inline: auto; padding: 48px 36px; text-align: center; }
  .result__icon {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    margin: 0 auto 22px;
    border-radius: 50%;
  }
  .result__icon--ok { background: #ecfdf5; color: #059669; }
  .result__box h1 { font-size: 30px; margin-bottom: 12px; }
  .result__box p { color: var(--muted); margin-bottom: 14px; }
  .result__order { font-weight: 700; color: var(--text); font-size: 16px; }
  .result__box .btn { margin-top: 10px; }
</style>
